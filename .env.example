# Core stockroom uses Sites-provisioned DB and BUCKET bindings.
# Authentication is provided by the Sites dispatcher.
# No external API credentials are required for the current manual workflows.
# Square, image recognition, accounting and subscription billing are not implemented connections.

# Optional Square reader, scoped to one authorised business workspace
SQUARE_ACCESS_TOKEN=
SQUARE_WORKSPACE_ID=
SQUARE_ENVIRONMENT=sandbox
# Optional transactional low-stock emails, scoped to one business
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_WORKSPACE_ID=
